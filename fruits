  var filtered = cat === 'All' ? products : products.filter(function(p) { return p.cat === cat; });
  renderProducts('allProducts', filtered);
}

/* ========== CART ========== */
function addToCart(id) {
  if (window.event) window.event.preventDefault();
  var product = products.find(function(p) { return p.id === id; });
  var existing = cart.find(function(c) { return c.id === id; });
  if (existing) { existing.qty++; } else { cart.push({id: product.id, name: product.name, price: product.price, img: product.img, qty: 1}); }
  updateCart();
  showToast(product.name + ' added to cart!');
}

function removeFromCart(id) {
  if (window.event) window.event.preventDefault();
  cart = cart.filter(function(c) { return c.id !== id; });
  updateCart();
}

function updateCart() {
  var body = document.getElementById('cartBody');
  var badge = document.getElementById('cartBadge');
  var total = document.getElementById('cartTotal');
  var count = 0;
  var sum = 0;
  cart.forEach(function(c) { count += c.qty; sum += c.price * c.qty; });
  badge.textContent = count;
  if (cart.length === 0) {
    body.innerHTML = '<div class="cart-empty"><i class="fas fa-shopping-basket"></i><p>Your cart is empty</p></div>';
    total.textContent = '$0.00';
    return;
  }
  body.innerHTML = cart.map(function(c) {
    return '<div class="cart-item">' +
      '<img src="' + c.img + '" alt="' + c.name + '">' +
      '<div class="ci-info"><h4>' + c.name + '</h4><div class="ci-price">$' + c.price.toFixed(2) + ' × ' + c.qty + '</div></div>' +
      '<button class="ci-remove" onclick="removeFromCart(' + c.id + ')"><i class="fas fa-trash"></i></button></div>';
  }).join('');
  total.textContent = '$' + sum.toFixed(2);
}

