function navLightbox(dir) {
  if (window.event) window.event.preventDefault();
  lbIndex = (lbIndex + dir + filteredGallery.length) % filteredGallery.length;
  document.getElementById('lbImg').src = filteredGallery[lbIndex].src;
}

/* ========== SEARCH ========== */
function openSearch() {
  if (window.event) window.event.preventDefault();
  document.getElementById('searchOverlay').classList.add('open');
  document.getElementById('searchInput').focus();
}

function closeSearch() {
  if (window.event) window.event.preventDefault();
  document.getElementById('searchOverlay').classList.remove('open');
}

function handleSearch(e) {
  if (e.key === 'Enter') {
    var q = e.target.value.toLowerCase().trim();
    if (!q) return;
    var found = products.filter(function(p) { return p.name.toLowerCase().indexOf(q) !== -1; });
    closeSearch();
    if (found.length) {
      goTo('products');
      setTimeout(function() { renderProducts('allProducts', found); }, 250);
    } else {
      showToast('No fruits found for "' + q + '"');
    }
  }
}

/* ========== SCROLL REVEAL ========== */
function initScrollReveal() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        e.target.classList.add('revealed');
        observer.unobserve(e.target);
      }
    });
  }, {threshold: 0.1, rootMargin: '0px 0px -40px 0px'});
  document.querySelectorAll('.reveal,.reveal-left,.reveal-right,.reveal-zoom').forEach(function(el) {
    if (!el.classList.contains('revealed')) observer.observe(el);
  });
}

/* ========== ANIMATED COUNTERS ========== */
function animateCounters() {
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        var el = e.target;
        var target = parseInt(el.dataset.count);
        var current = 0;
        var step = Math.ceil(target / 60);
        var timer = setInterval(function() {
          current += step;
          if (current >= target) { current = target; clearInterval(timer); }
          el.textContent = current.toLocaleString() + '+';
        }, 25);
        observer.unobserve(el);
      }
    });
  }, {threshold: 0.5});
  document.querySelectorAll('.num[data-count]').forEach(function(el) {
    if (!el.dataset.animated) { el.dataset.animated = '1'; observer.observe(el); }
  });
}
window.addEventListener('scroll', animateCounters);

/* ========== TOAST ========== */
function showToast(msg) {
  var toast = document.getElementById('toast');
  toast.innerHTML = '<i class="fas fa-check-circle"></i> ' + msg;
  toast.classList.add('show');
  clearTimeout(toast._timer);
  toast._timer = setTimeout(function() { toast.classList.remove('show'); }, 3000);
}

/* ========== COOKIE ========== */
function acceptCookies() {
  if (window.event) window.event.preventDefault();
  localStorage.setItem('cookieAccepted', 'true');
  document.getElementById('cookieConsent').classList.remove('show');
}

/* ========== NEWSLETTER POPUP ========== */
function closeNlPopup() {
  if (window.event) window.event.preventDefault();
  document.getElementById('nlPopup').classList.remove('show');
}

function subscribeNl() {
  if (window.event) window.event.preventDefault();
  var email = document.getElementById('nlEmail').value;
  if (email && email.indexOf('@') !== -1) {
    localStorage.setItem('nlSubscribed', 'true');
    closeNlPopup();
    showToast('Subscribed! Check your inbox for 15% off.');
  } else {
    showToast('Please enter a valid email address.');
  }
}

function subscribeFooterNl() {
  if (window.event) window.event.preventDefault();
  var email = document.getElementById('footerNl').value;
  if (email && email.indexOf('@') !== -1) {
    document.getElementById('footerNl').value = '';
    showToast('Successfully subscribed to newsletter!');
  } else {
    showToast('Please enter a valid email address.');
  }
}

/* ========== LIVE CHAT ========== */
function toggleChat() {
  if (window.event) window.event.preventDefault();
  document.getElementById('chatBox').classList.toggle('open');
}

function sendChat() {
  if (window.event) window.event.preventDefault();
  var input = document.getElementById('chatInput');
  var msg = input.value.trim();
  if (!msg) return;
  var body = document.getElementById('chatBody');
  body.innerHTML += '<div class="chat-msg user">' + msg + '</div>';
  input.value = '';
  body.scrollTop = body.scrollHeight;
  setTimeout(function() {
    var replies = [
      'Thank you for your message! Let me look into that for you.',
      'Great question! Our fruits are delivered within 24 hours of harvest.',
      'I\'d be happy to help! Could you provide your order number?',
      'We currently have a 30% off promotion for first-time orders with code FRESH30!',
      'Our customer support team will get back to you shortly. Is there anything else I can help with?'
    ];
    body.innerHTML += '<div class="chat-msg bot">' + replies[Math.floor(Math.random() * replies.length)] + '</div>';
    body.scrollTop = body.scrollHeight;
  }, 1000);
}

function handleChat(e) { if (e.key === 'Enter') sendChat(); }

/* ========== CONTACT FORM ========== */
function handleContact(e) {
  e.preventDefault();
  showToast('Message sent successfully! We\'ll get back to you soon.');
  e.target.reset();
}

/* ========== LOGIN ========== */
function handleLogin(e) {
  e.preventDefault();
  showToast('Login successful! Welcome back to FRUITS CABIN.');
  setTimeout(function() { goTo('home'); }, 1200);
}

/* ========== KEYBOARD SHORTCUTS ========== */
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeSearch();
    closeLightbox();
    closeNlPopup();
    document.getElementById('cartSidebar').classList.remove('open');
    document.getElementById('chatBox').classList.remove('open');
    closeMobileNav();
  }
  if (document.getElementById('lightbox').classList.contains('open')) {
    if (e.key === 'ArrowLeft') navLightbox(-1);
    if (e.key === 'ArrowRight') navLightbox(1);
  }
});
