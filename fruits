/* ========== CORE NAVIGATION FUNCTION ========== */
function goTo(page) {
  /* Prevent default on any event that triggered this */
  if (window.event) window.event.preventDefault();

  /* Don't reload same page */
  if (currentPage === page) {
    window.scrollTo({top: 0, behavior: 'smooth'});
    return;
  }

  /* Close mobile nav if open */
  closeMobileNav();

  /* Fade out current page */
  const currentEl = document.getElementById('page-' + currentPage);
  if (currentEl) {
    currentEl.classList.remove('visible');
  }

  /* After fade out, switch pages */
  setTimeout(function() {
    /* Hide all pages */
    document.querySelectorAll('.page').forEach(function(p) {
      p.classList.remove('active', 'visible');
    });

    /* Show target page */
    const targetEl = document.getElementById('page-' + page);
    if (targetEl) {
      targetEl.classList.add('active');
      /* Trigger reflow for animation */
      void targetEl.offsetWidth;
      targetEl.classList.add('visible');
    }

    /* Update active state on ALL nav links (desktop + mobile) */
    document.querySelectorAll('[data-page]').forEach(function(a) {
      if (a.dataset.page === page) {
        a.classList.add('active');
      } else {
        a.classList.remove('active');
      }
    });

    currentPage = page;
    window.scrollTo({top: 0, behavior: 'instant'});

    /* Re-initialize animations for new page */
    setTimeout(function() {
      initScrollReveal();
      animateCounters();
    }, 80);
  }, currentPage === 'home' && !currentEl.classList.contains('visible') ? 0 : 150);
}

