    if (p.rating % 1 >= 0.5) stars += '<i class="fas fa-star-half-alt"></i>';
    return '<div class="product-card reveal" style="transition-delay:' + (i * 0.05) + 's;">' +
      '<div class="img-wrap">' +
        '<img src="' + p.img + '" alt="' + p.name + '" loading="lazy">' +
        '<div class="badges">' +
          (p.discount ? '<span class="badge-discount">-' + p.discount + '%</span>' : '') +
          (p.organic ? '<span class="badge-organic">Organic</span>' : '') +
        '</div>' +
        '<div class="actions">' +
          '<button onclick="toggleWishlist(' + p.id + ')" title="Add to Wishlist"><i class="fas fa-heart"></i></button>' +
          '<button onclick="quickView(' + p.id + ')" title="Quick View"><i class="fas fa-eye"></i></button>' +
        '</div>' +
      '</div>' +
      '<div class="info">' +
        '<h3>' + p.name + '</h3>' +
        '<div class="rating">' + stars + ' <span>' + p.rating + ' (' + p.reviews + ')</span></div>' +
        '<div class="price-row">' +
          '<div class="price">$' + p.price.toFixed(2) + (p.old ? '<span class="old">$' + p.old.toFixed(2) + '</span>' : '') + '</div>' +
          '<button class="add-btn" onclick="addToCart(' + p.id + ')" title="Add to Cart"><i class="fas fa-plus"></i></button>' +
